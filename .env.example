# Card payments (Stripe) - from your Stripe dashboard, live keys for real charges
STRIPE_SECRET_KEY=sk_live_or_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Product image uploads - create a Blob store in your Vercel project (Storage tab) and copy its token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# Outgoing email (order confirmations, tracking updates, admin notifications)
# Example for a Gmail account with an App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cleanwithbest@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM=cleanwithbest@gmail.com
